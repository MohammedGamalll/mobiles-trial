{
  "name": "motamayez-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "app.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"cross-env SERVE_STATIC=0 tsx server/index.ts\" \"vite\"",
    "build": "vite build && node scripts/bundle-server.mjs && node scripts/migrate.mjs",
    "start": "node app.cjs",
    "preview": "npm run build && npm start",
    "db:import": "node scripts/import-d1.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "build:live": "npm run build && npm run db:migrate",
    "test": "tsx --test tests/calc.test.ts tests/party-money.test.ts tests/pos-today.test.ts tests/delivery-pod.test.ts tests/gps-ping.test.ts",
    "pack:hostinger": "node scripts/pack-hostinger.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.9.6",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.8.2",
    "recharts": "^3.1.2",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
