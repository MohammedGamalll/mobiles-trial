# Copy to `.env` locally. Never commit `.env`.
# On Hostinger set the same keys in hPanel → Node.js → Environment variables.

# Hostinger MySQL: use 127.0.0.1 (not localhost). Create the empty database in hPanel first.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=u493965445_motamayez
MYSQL_USER=u493965445_motamayez
MYSQL_PASSWORD=

# Product images (File Manager). Backups are .sql dumps next to this folder.
UPLOAD_DIR=/home/u493965445/domains/elmotmyz.shop/.motamayez/uploads
BACKUP_DIR=/home/u493965445/domains/elmotmyz.shop/.motamayez/backups

# Hostinger fills PORT. Local default is 8787.
# PORT=8787
# HOST=0.0.0.0
